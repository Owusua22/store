# ── Supabase (optional) ─────────────────────────────────────────────
# Without these keys the app runs in demo mode with a bundled skincare
# catalogue, local cart and client-side sign-in, so the UI is fully browsable.
# Setup: run supabase/schema.sql then supabase/seed.sql, and read
# docs/backend-setup.md for creating the first admin user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (optional, for admin image uploads) ──────────────
# Create a bucket + API token in the Cloudflare dashboard, enable public
# access (r2.dev URL or a custom domain) and point *_PUBLIC_URL at it.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Your bucket name (defaults to "glow-up" if left empty)
CLOUDFLARE_R2_BUCKET_NAME=glow-up
# Public base URL of the bucket, no trailing slash.
# Enable public access on the bucket first: R2 -> glow-up -> Settings -> Public access
# (r2.dev URL like https://pub-xxxxxxxx.r2.dev, or a custom domain).
CLOUDFLARE_R2_PUBLIC_URL=

# ── Misc ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUTTONDOWN_API_KEY=
